# ---- 依赖 ----
node_modules/
jspm_packages/

# ---- 日志 ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- 环境变量 / 凭据（绝不入库）----
.env
.env.local
.env.*.local
*.pem
*.key
id_ed25519*
id_rsa*

# ---- 缓存 / 构建产物 ----
.cache/
dist/
build/
coverage/
.nyc_output/

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# ★ 本仓库的核心纪律：数据库一律不入库
#   mnemon / StrataGate / graph-memory 的 SQLite 都是二进制，
#   进 git 既无法 diff，又会在并发写时产生冲突副本。
#   记忆只以 out/*.jsonl 这类纯文本形式入库。
# ============================================================
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---- 中间产物 / 草稿 ----
_scratch/
out/*.tmp
*.tmp
*.bak
!persona/archive/*.bak-*
